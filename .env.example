# Copy to .env and fill in. NEVER commit .env.
# Secrets only here; everything else goes in config.yml.

# Jellyfin admin passwords. Leave blank to have bootstrap generate one (shown once).
ADMIN_PASSWORD_ALICE=

# Metadata provider keys (get your own; see docs/CONFIGURATION.md)
TMDB_API_KEY=

# Set by bootstrap; do not fill by hand.
JELLYFIN_API_KEY=

# Container user/group (run `id -u` and `id -g`)
PUID=1000
PGID=1000

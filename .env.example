# Copy to .env and fill in. NEVER commit .env.
# Secrets only here; everything else goes in config.yml.

# Jellyfin admin passwords. Leave blank to have bootstrap generate one (shown once).
ADMIN_PASSWORD_ALICE=

# Metadata provider keys (get your own; see docs/CONFIGURATION.md)
TMDB_API_KEY=

# Optional override. Bootstrap saves its own key to data/companion/jellyfin_api_key (0600).
JELLYFIN_API_KEY=

# Host folder with your media. Mounted read-only into every container.
MEDIA_DIR=/path/to/your/media

# Host port for Jellyfin (bound to 127.0.0.1 only)
JELLYFIN_PORT=8096

# Container user/group (run `id -u` and `id -g`)
PUID=1000
PGID=1000
